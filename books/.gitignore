__pycache__/
*.pyc
.DS_Store

# The repo root ignores every PDF. Re-include sample books in this directory.
!*.pdf

# Copyrighted evaluation copy (Bhaktivedanta Book Trust, 1972–2004).
# 4.1 MB, under GitHub's 100 MB limit, but the license forbids reproducing
# more than 10% of the book. Keep the file on this machine.
sample_pdfs/Bhagavad-gita_As_It_Is.pdf

# Safari printout of a Temple Library Q&A session, not a source edition.
sample_pdfs/arthashastra.pdf

# Full extracted text of the copyrighted Gita edition.
outputs/bhagavad_gita_stage1_chunks.json

# Retrieved passage text from that edition. Score summaries stay tracked.
outputs/bhagavad_gita_*_results*.json

# Short excerpts flagged in review. Local copies stay; they are not published.
outputs/bhagavad_gita_stage1_validation.json
outputs/bge_m3_fusion_offline_comparison.json
outputs/qwen3_reranker_0_6b_local_vs_hybrid_comparison.json

# Full text of the Temple Library printout, and passage previews from it.
outputs/arthashastra_stage1_chunks.json
outputs/arthashastra_*_results*.json
outputs/arthashastra_stage1_validation.json
