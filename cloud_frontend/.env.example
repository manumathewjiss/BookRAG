# BookRAG Next.js frontend. Never put service-role keys or provider API keys here.
# The browser only receives the Supabase anon key and the public API origin.

# --- Required for a real deployment (Vercel Production) ---
# Project URL from Supabase Settings → API. Anon/public key only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Public FastAPI origin. Browser calls this with Authorization: Bearer <access token>.
# Local: http://localhost:8000   Production: https://YOUR_RENDER_SERVICE.onrender.com
NEXT_PUBLIC_BOOKRAG_API_URL=http://localhost:8000

# --- Local UI only. Must stay unset/false on Vercel Production. ---
# Production builds refuse to compile if either of these is true.
NEXT_PUBLIC_BOOKRAG_USE_MOCK=false
NEXT_PUBLIC_BOOKRAG_LOCAL_TEST_AUTH=false

# Optional display name for the mock-local session. Not sent as a user id to the API.
NEXT_PUBLIC_BOOKRAG_MOCK_EMAIL=demo@bookrag.local

# Do not add:
# SUPABASE_SERVICE_ROLE_KEY, VOYAGE_API_KEY, OPENAI_API_KEY, DATABASE_URL
