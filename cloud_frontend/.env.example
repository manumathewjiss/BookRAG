# BookRAG Next.js frontend. Never put service-role keys or provider API keys here.
# The browser only receives the Supabase anon key and the public API origin.

# Supabase Auth (anon/public). Service role stays on the FastAPI backend only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Codex FastAPI origin. Browser calls this with Authorization: Bearer <access token>.
NEXT_PUBLIC_BOOKRAG_API_URL=http://localhost:8000

# Isolated mocks until Codex endpoints are live. Default on for local UI work.
# Set to "false" only after the backend /api/v1 routes accept traffic.
NEXT_PUBLIC_BOOKRAG_USE_MOCK=true

# Optional display name for the mock-local session. Not sent as a user id to the API.
NEXT_PUBLIC_BOOKRAG_MOCK_EMAIL=demo@bookrag.local
